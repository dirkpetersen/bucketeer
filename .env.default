# =============================================================================
# Bucketeer configuration
# =============================================================================
#
# Copy this file to .env (git-ignored) and fill in the REQUIRED settings.
# On appmotel the copy happens automatically on first deploy; edit the live
# file with `appmo env bucketeer`, then `appmo restart bucketeer`.
#
# Every setting is marked either:
#   REQUIRED - site-specific, left empty here. The app refuses to start until
#              it is set, rather than running with a placeholder.
#              A few are REQUIRED only for one ADMIN_BACKEND; their comment says
#              which. With the default (rgw) these are RGW_ADMIN_URL,
#              RGW_ADMIN_ACCESS_KEY, RGW_ADMIN_SECRET_KEY and S3_ENDPOINT_URL;
#              with ADMIN_BACKEND=croit they are CROIT_URL and CROIT_API_TOKEN.
#   Default  - the value shown is also what the app uses when the line is
#              missing, so you only change it to deviate from the default.
#
# Format rules (this file is read by python-dotenv, appmotel and systemd):
# - One KEY=VALUE per line. Comments go on their own line: systemd would treat
#   a trailing "# ..." as part of the value.
# - Values must not contain  $(  `  ;  &&  ||  or an unquoted  |  because
#   appmotel silently drops such lines. Wrap values that contain spaces or a |
#   in double quotes.
# - Booleans are true or false.


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# TCP port the server listens on.
# Default: 8000. appmotel replaces any port below 10001 with one it assigns
# (10001-59999), so leave this alone when deploying there.
PORT=8000

# Interface to bind.
# Default: 127.0.0.1. Correct behind appmotel's Traefik proxy, which connects
# via localhost. Use 0.0.0.0 only when nothing else terminates TLS in front.
HOST=127.0.0.1

# Name shown in the page title and header.
# Default: Bucketeer
APP_NAME="Bucketeer"

# Path of the liveness endpoint. appmotel/Traefik polls it every 30s.
# It answers without contacting LDAP or croit, so an outage there does not get
# the app restarted.
# Default: /health
HEALTH_CHECK_PATH=/health

# Log verbosity: debug, info, warning or error. Passwords and S3 secret keys
# are never logged at any level.
# Default: info
LOG_LEVEL=info

# Directory for Bucketeer's SQLite database (settings edited on the admin
# page, uid mappings, bucket-key ownership, audit log). Relative paths are
# relative to the repo root. The default data/ is git-ignored, survives
# appmotel updates and is included in appmotel backups.
# Default: data
DATA_DIR=data


# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

# Key that signs session cookies. Changing it logs everyone out.
# REQUIRED. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# How long a login lasts, in seconds. Kept short because the dashboard shows
# secret keys; users typically copy their config and leave.
# Default: 3600 (1 hour)
SESSION_MAX_AGE=3600

# Send the session cookie only over HTTPS.
# Default: true. Set to false only for local development over plain http.
SESSION_COOKIE_SECURE=true


# -----------------------------------------------------------------------------
# Active Directory login (LDAPS)
# -----------------------------------------------------------------------------
# Users sign in with their AD username or email address and AD password.
# Login works like this: bind as the service account, search for the user
# with LDAP_USER_FILTER, require exactly one match, check group membership,
# then bind as that user to verify the password.

# Domain controller URL(s), comma-separated, tried in order. Must be ldaps://.
# REQUIRED. Example: ldaps://dc1.example.org:636,ldaps://dc2.example.org:636
LDAP_URL=

# Directory subtree searched for user accounts.
# REQUIRED. Example: "DC=example,DC=org"
LDAP_BASE_DN=

# Service account used for the user search. A full DN or a UPN both work.
# It needs read access only; do not use a privileged account.
# REQUIRED. Example: svc-bucketeer@example.org
LDAP_BIND_DN=

# Password of the service account. Quote it if it contains spaces; see the
# format rules above for characters appmotel rejects.
# REQUIRED.
LDAP_BIND_PASSWORD=

# Filter that finds the account. {login} is replaced with the LDAP-escaped
# text from the login form. It matches username, email or UPN, and it skips
# disabled accounts (the userAccountControl ACCOUNTDISABLE bit).
# Must stay double-quoted because it contains a |.
# Default: as shown.
LDAP_USER_FILTER="(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2))(|(sAMAccountName={login})(mail={login})(userPrincipalName={login})))"

# Attribute that identifies the user, whichever form they logged in with.
# Its value is also the user's RGW (S3) uid.
# Default: sAMAccountName
LDAP_USERNAME_ATTRIBUTE=sAMAccountName

# Attribute shown as the user's name in the dashboard.
# Default: displayName
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName

# Attribute holding the user's email address. It is used for display and,
# when an RGW user is created, as that user's email.
# Default: mail
LDAP_EMAIL_ATTRIBUTE=mail

# DN of the group whose members may log in. Membership through nested groups
# counts. Strongly recommended: when empty, every enabled AD account that
# matches LDAP_USER_FILTER can log in.
# Default: empty (no group restriction).
# Example: "CN=S3-Users,OU=Groups,DC=example,DC=org"
LDAP_REQUIRED_GROUP_DN=

# DN of the group whose members get the admin view.
# Default: empty (no admins).
LDAP_ADMIN_GROUP_DN=

# PEM file with the CA certificate(s) that signed the domain controllers'
# certificates. This is typically the AD Certificate Services root CA.
# Default: empty (use the system trust store).
LDAP_CA_CERT_FILE=

# Verify the domain controllers' TLS certificates.
# Default: true. Never disable in production: passwords travel over this
# connection.
LDAP_TLS_VERIFY=true

# Connect and operation timeout per domain controller, in seconds.
# Default: 5
LDAP_TIMEOUT=5


# -----------------------------------------------------------------------------
# Admin backend and croit API
# -----------------------------------------------------------------------------

# Which API Bucketeer uses for the admin plane (S3 users, keys, quotas, bucket
# lists): rgw (the RGW Admin Ops API, see the RGW_ADMIN_* settings below) or
# croit (the croit management API, kept until the cluster check). Setup guide
# for rgw: docs/admin-ops-setup.md. There is no fallback between the two: the
# app refuses to start when the chosen backend's settings are missing.
# With rgw, S3_ENDPOINT_URL is REQUIRED (there is no croit .s3cfg to discover
# it from) and admins type the placement ids on the Settings tab.
# The settings of the other backend are ignored.
# Default: rgw
ADMIN_BACKEND=rgw

# Base URL of the croit management API, without a trailing slash.
# REQUIRED only when ADMIN_BACKEND=croit, ignored otherwise.
# Example: https://croit.example.org/api
# To limit what a leaked token can do, point this at the croit-gate allowlisting
# gateway (tools/croit-gate, optional, croit backend only), e.g.
# http://127.0.0.1:18089/api, and set CROIT_API_TOKEN to the gateway's client
# token (see tools/README.md).
CROIT_URL=

# croit API token that Bucketeer uses for all croit calls, sent as
# "Authorization: Bearer <token>". Behind croit-gate this is the gateway's
# client token, not the real croit token. It needs the viewer and admin roles: it
# reads S3 keys, creates and suspends users, and manages buckets and quotas.
# REQUIRED only when ADMIN_BACKEND=croit, ignored otherwise.
CROIT_API_TOKEN=

# PEM file with the CA certificate for the croit endpoint.
# Default: empty (use the system trust store).
CROIT_CA_CERT_FILE=

# Verify croit's TLS certificate.
# Default: true. Never disable in production: S3 secret keys travel over
# this connection.
CROIT_TLS_VERIFY=true

# Request timeout for croit API calls, in seconds.
# Default: 15
CROIT_TIMEOUT=15


# -----------------------------------------------------------------------------
# RGW Admin Ops (the default ADMIN_BACKEND=rgw)
# -----------------------------------------------------------------------------

# Base URL of the RGW gateway that serves the Admin Ops API (/admin/...), without
# a trailing slash. Requests are signed with AWS Signature V4 (service s3, region
# S3_REGION). Plain http is accepted only for a loopback host. TLS verification
# follows S3_TLS_VERIFY and S3_CA_CERT_FILE.
# REQUIRED (with the default ADMIN_BACKEND=rgw), ignored with croit.
# Use an internal RGW address, not the public S3 endpoint, and keep /admin off
# the public endpoint (see docs/admin-ops-setup.md).
# Example: https://rgw-internal.example.org
RGW_ADMIN_URL=

# Access key of the RGW user that holds the Admin Ops caps (users, buckets,
# usage and metadata read).
# REQUIRED (with the default ADMIN_BACKEND=rgw), ignored with croit.
RGW_ADMIN_ACCESS_KEY=

# Secret key of that user. Never logged or returned by any endpoint.
# REQUIRED (with the default ADMIN_BACKEND=rgw), ignored with croit.
RGW_ADMIN_SECRET_KEY=

# Request timeout for RGW Admin Ops calls, in seconds.
# Default: 15
RGW_ADMIN_TIMEOUT=15


# -----------------------------------------------------------------------------
# S3 and the generated ~/.aws/config / ~/.aws/credentials snippets
# -----------------------------------------------------------------------------

# Public S3 endpoint, written as endpoint_url in ~/.aws/config. Set this to
# the load-balanced or DNS name users should use.
# REQUIRED (with the default ADMIN_BACKEND=rgw). With croit it is optional and
# the default is empty: use the gateway address in the croit .s3cfg of the user; when that
# is not available either, the credentials screen asks users to contact an
# administrator.
# Example: https://s3.example.org
S3_ENDPOINT_URL=

# Region written to ~/.aws/config. Ceph RGW accepts any value unless the
# zonegroup is configured otherwise, but the AWS SDKs require one. Letters,
# digits, - and _ only.
# Default: us-east-1
S3_REGION=us-east-1

# How the AWS CLI/SDKs put the bucket name into the request, written as
# addressing_style in ~/.aws/config: path (https://host/bucket), virtual
# (https://bucket.host, needs wildcard DNS and a wildcard certificate) or auto.
# RGW without wildcard DNS needs path.
# Default: path
S3_ADDRESSING_STYLE=path

# Profile name in the generated snippets. Users select it with
# "--profile <name>" or AWS_PROFILE=<name>. It is a named profile rather than
# "default", so pasting the snippet does not overwrite an existing default
# profile. Letters, digits, . _ - only (it becomes an INI section name); the
# app refuses to start otherwise.
# Default: bucketeer
AWS_PROFILE_NAME=bucketeer

# RGW tenant the users live in. When set, users are addressed as tenant$uid.
# Default: empty (no tenant).
S3_TENANT=

# PEM file with the CA certificate for the S3 endpoint. Bucketeer itself calls
# the S3 API, with each user's own keys, for features croit lacks (lifecycle,
# CORS, tagging, presigned links and so on).
# Default: empty (use the system trust store).
S3_CA_CERT_FILE=

# Verify the S3 endpoint's TLS certificate.
# Default: true
S3_TLS_VERIFY=true


# -----------------------------------------------------------------------------
# appmotel overrides (optional, read by appmotel, not by the app)
# -----------------------------------------------------------------------------
# Uncomment to change appmotel's per-app defaults.
# MEMORY_LIMIT=512M
# CPU_QUOTA=100%
# RATE_LIMIT_AVG=100
# RATE_LIMIT_BURST=50
