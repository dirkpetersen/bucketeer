def write_file(path, data, mode, overwrite=True):
    """Write `data` atomically with `mode`. Returns False if left alone."""
    if not overwrite and os.path.lexists(path):
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.new.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, mode)
        if overwrite:
            os.replace(tmp, path)
        else:
            try:
                os.link(tmp, path)  # fails if the path appeared meanwhile: race-free
            except FileExistsError:
                return False
    finally:
        if os.path.lexists(tmp):
            os.unlink(tmp)
    return True


def install(enable=False, home=None, script=None):
    """Install the gateway for the current user. Returns the printed lines."""
    home = home or os.path.expanduser("~")
    if os.geteuid() == 0:
        raise ValueError("run install as the gateway's own unprivileged user, not root")
    script = script or os.path.abspath(__file__)
    exe = os.path.join(home, ".local", "bin", "croit-gate")
    env = os.path.join(home, ".config", "croit-gate", "env")
    unit = os.path.join(home, ".config", "systemd", "user", "croit-gate.service")
    for value in (exe, env):
        if re.search(r"[\s%$\\\"']", value):
            raise ValueError(f"unsupported character in path {value!r}")
    with open(script, "rb") as f:
        code = f.read()
    write_file(exe, code, 0o755)
    write_file(unit, (UNIT_TEMPLATE % {"exe": exe, "env": env}).encode(), 0o644)
    created = write_file(env, ENV_TEMPLATE.encode(), 0o600, overwrite=False)
    lines = [
        f"Installed {exe}",
        f"Wrote {unit}",
        f"Created {env} (mode 0600): fill in the tokens" if created
        else f"Kept the existing {env} (not modified)",
    ]
    if enable:
        import subprocess
        for cmd in (["systemctl", "--user", "daemon-reload"],
                    ["systemctl", "--user", "enable", "--now", "croit-gate"]):
            subprocess.run(cmd, check=True)
        lines.append("Enabled and started croit-gate.service")
    else:
        lines += [
            "Next steps:",
            f"  1. edit {env}",
            f"  2. {exe} --check   (after loading the env file)",
            "  3. loginctl enable-linger $USER   (may need an administrator)",
            "  4. systemctl --user daemon-reload && systemctl --user enable --now croit-gate",
        ]
    return lines


def parse_args(argv=None):
    p = argparse.ArgumentParser(
        prog="croit-gate",
        description="Allowlisting gateway in front of the croit API. Forwards only the "
        "calls Bucketeer needs, with the real croit token, to clients that present "
        "the client token.",
        epilog="Configuration comes from environment variables; see the script header.",
    )
    p.add_argument("command", nargs="?", choices=["install"],
                   help="install: copy this script and a systemd user unit to the current "
                   "user's home (see the script header)")
    p.add_argument("--enable", action="store_true",
                   help="with install: also run systemctl --user daemon-reload and enable --now")
    p.add_argument("--check", action="store_true",
                   help="validate the configuration, test the croit token, and exit")
    p.add_argument("--allow-remote", action="store_true",
                   help="allow CROIT_GATE_LISTEN on a non-loopback address (plain HTTP: "
                   "the client token is exposed to that network)")
    return p.parse_args(argv)


def main(argv=None):
    if sys.version_info < MIN_PYTHON:
        die("needs Python {}.{} or newer".format(*MIN_PYTHON))
    args = parse_args(argv)
    logging.basicConfig(level=logging.INFO, stream=sys.stderr,
                        format="%(asctime)s croit-gate %(levelname)s %(message)s")
    if args.command == "install":
        try:
            print("\n".join(install(enable=args.enable)))
        except (ValueError, OSError) as e:
            die(str(e))
        except Exception as e:  # systemctl failure
            die(f"systemctl failed: {e}")
        return
    try:
        cfg = Config(os.environ, allow_remote=args.allow_remote)
    except ValueError as e:
        die(str(e))
    try:
        ok, message = upstream_check(cfg)
    except Exception as e:  # only the type: the text could hold the token
        ok, message = False, f"croit check failed ({exc_name(e)})"
    if args.check:
        print(f"croit-gate: {'ok' if ok else 'error'}: {message}")
        if ok:
            print(f"croit-gate: would listen on {cfg.listen[0]}:{cfg.listen[1]}, "
                  f"forwarding to {cfg.scheme}://{cfg.upstream_host}:{cfg.upstream_port}{cfg.base}")
        sys.exit(0 if ok else 1)
    if not ok:
        log.warning("%s (continuing; requests will fail until croit is reachable)", message)
    try:
        server = Gate(cfg)
    except OSError as e:
        die(f"cannot listen on {cfg.listen[0]}:{cfg.listen[1]}: {e}")
    log.info("listening on %s:%d, forwarding %d routes to %s://%s:%d%s", cfg.listen[0],
             server.server_address[1], len(ROUTES), cfg.scheme, cfg.upstream_host,
             cfg.upstream_port, cfg.base)

    def stop(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, stop)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
